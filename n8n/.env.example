# Copy to .env before `docker compose up`.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n

# Where n8n is reachable. For local development the defaults are fine; behind
# a reverse proxy set N8N_HOST to the public hostname and WEBHOOK_URL to the
# public https URL, or registered webhook URLs will point at localhost.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Bogota

# openssl rand -hex 32  -- back this up, it decrypts every stored credential.
N8N_ENCRYPTION_KEY=

# Must be byte-identical to CONSERJE_WEBHOOK_SECRET in backend/.env.
CONSERJE_WEBHOOK_SECRET=
