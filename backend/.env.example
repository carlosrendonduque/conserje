# ---------------------------------------------------------------------------
# Conserje backend configuration.
#
# Copy to .env and fill in. This file is the ONLY place credentials live.
# Nothing here is ever sent to the browser -- see docs/SECURITY.md.
# ---------------------------------------------------------------------------

# Anthropic API key. Required.
ANTHROPIC_API_KEY=sk-ant-...

# Directory for conversation state and rate-limit buckets.
# Must be writable by the web server and MUST NOT be inside public/.
CONSERJE_STATE_DIR=./var

# Directory holding the per-site JSON configs.
CONSERJE_SITES_DIR=../sites

# Shared secret used to sign outbound webhook payloads (HMAC-SHA256).
# Generate one with: openssl rand -hex 32
# The same value goes into the n8n workflow's signature check.
CONSERJE_WEBHOOK_SECRET=

# Per-site webhook endpoints. Each site config names the variable it reads,
# so adding a site never means touching code.
CONSERJE_WEBHOOK_CARLOS_PORTFOLIO=https://n8n.example.com/webhook/conserje-lead
CONSERJE_WEBHOOK_CEREBRITOFELIZ=https://n8n.example.com/webhook/conserje-lead
