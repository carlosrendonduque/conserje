# ---------------------------------------------------------------------------
# Conserje backend configuration.
#
# In production these are Netlify environment variables, not a file. Nothing
# here is ever sent to the browser -- see docs/SECURITY.md.
# ---------------------------------------------------------------------------

# Anthropic API key. Required.
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret used to sign outbound webhook payloads (HMAC-SHA256).
# Generate one with: openssl rand -hex 32
# The same value goes into the n8n workflow's signature check.
CONSERJE_WEBHOOK_SECRET=

# Per-site webhook endpoints. Each site config names the variable it reads,
# so adding a site never means touching code.
CONSERJE_WEBHOOK_CARLOSRENDON=https://your-instance.app.n8n.cloud/webhook/conserje-lead

# Only for local runs against a checkout whose sites/ sits somewhere unusual.
# CONSERJE_SITES_DIR=../sites
